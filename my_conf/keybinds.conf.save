
$mod 			= alt
$terminal 		= kitty
$menu 			= rofi
$left 			= j
$right 			= semicolon
$up 			= k
$down 			= l
$waybar_config	= ~/.config/waybar/waybar-config/config
$waybar_style 	= ~/.config/waybar/waybar-config/style.css

# █░█░█ █ █▄░█ █▀▄ █▀█ █░█░█   █▀▄▀█ ▄▀█ █▄░█ ▄▀█ █▀▀ █▀▄▀█ █▀▀ █▄░█ ▀█▀
# ▀▄▀▄▀ █ █░▀█ █▄▀ █▄█ ▀▄▀▄▀   █░▀░█ █▀█ █░▀█ █▀█ █▄█ █░▀░█ ██▄ █░▀█ ░█░
bind = $mod SHIFT, Q, 		killactive
bind = $mod, M, 			exec, command -v
bind = $mod, F, 			fullscreen
bind = $mod, Space, 		togglefloating
#bind = $mod, Tab,			hyprtasking:toggle, all

# Specific
bind = $mod, RETURN,        exec, $terminal --directory=~   # Terminal
bind = $mod, E,				exec, $terminal --directory -e  yazi	# File Manager
bind = $mod SHIFT, E,       exec, nemo				        # File Manager
bind = $mod SHIFT, F,       exec, firefox                   # Internet Browser
bind = $mod, D,             exec, $menu -show drun          # App Menu
bind = $mod SHIFT, M,       exec, ncmpcpp					# Music Player

bind = $mod CTRL, j,		exec, wtype -P left

# Toggle second monitor on/off  
bind = $mod SHIFT, F9,		eec, hyprctl dispatch dpms toggle DP-2

# █▀▀ █▀█ █▀▀ █░█ █▀
# █▀░ █▄█ █▄▄ █▄█ ▄█
bind = $mod, $left, 		movefocus, l
bind = $mod, $right, 		movefocus, r
bind = $mod, $up, 			movefocus, u
bind = $mod, $down, 		movefocus, d

# █▀▄▀█ █▀█ █░█ █▀▀
# █░▀░█ █▄█ ▀▄▀ ██▄
bind = $mod SHIFT, $left, 	movewindow, l
bind = $mod SHIFT, $right, 	movewindow, r
bind = $mod SHIFT, $up, 	movewindow, u
bind = $mod SHIFT, $down, 	movewindow, d
bindm = $mod, mouse:272, 	movewindow
bindm = $mod, mouse:273, 	resivewindow

# █▀█ █▀▀ █▀ █ ▀█ █▀▀
# █▀▄ ██▄ ▄█ █ █▄ ██▄
bind = $mod CTRL, $left, 	resizeactive, -20 0
bind = $mod CTRL, $right, 	resizeactive, 20 0
bind = $mod CTRL, $up, 		resizeactive, 0 -20
bind = $mod CTRL, $down, 	resizeactive, 0 20 


# █░█░█ █▀█ █▀█ █▄▀ █▀ █▀█ ▄▀█ █▀▀ █▀▀ █▀
# ▀▄▀▄▀ █▄█ █▀▄ █░█ ▄█ █▀▀ █▀█ █▄▄ ██▄ ▄█
	# Nums
bind = $mod, 1, 			workspace, 1
bind = $mod, 2, 			workspace, 2
bind = $mod, 3, 			workspace, 3
bind = $mod, 4, 			workspace, 4
bind = $mod, 5, 			workspace, 5
bind = $mod, 6, 			workspace, 6
bind = $mod, 7, 			workspace, 7
bind = $mod, 8, 			workspace, 8
bind = $mod, 9, 			workspace, 9
bind = $mod, 0, 			workspace, 10
	# back and forth
bind = $mod, TAB,           workspace, previous
bind = $mod SHIFT, right, 	workspace, e+1
bind = $mod SHIFT, left,	workspace, e-1
	# Numpad
bind = $mod, KP_End,		workspace, 1
bind = $mod, KP_Down,		workspace, 2
bind = $mod, KP_Next,		workspace, 3
bind = $mod, KP_Left,		workspace, 4
bind = $mod, KP_Begin, 		workspace, 5
bind = $mod, KP_Right,		workspace, 6
bind = $mod, KP_Home, 		workspace, 7
bind = $mod, KP_Up,			workspace, 8
bind = $mod, KP_Prior,		workspace, 9
bind = $mod, KP_Insert, 	workspace, 10

bind = $mod SHIFT, 1, 		movetoworkspace, 1
bind = $mod SHIFT, 2, 		movetoworkspace, 2
bind = $mod SHIFT, 3, 		movetoworkspace, 3
bind = $mod SHIFT, 4, 		movetoworkspace, 4
bind = $mod SHIFT, 5, 		movetoworkspace, 5
bind = $mod SHIFT, 6, 		movetoworkspace, 6
bind = $mod SHIFT, 7, 		movetoworkspace, 7
bind = $mod SHIFT, 8, 		movetoworkspace, 8
bind = $mod SHIFT, 9, 		movetoworkspace, 9
bind = $mod SHIFT, 0, 		movetoworkspace, 10

bind = $mod SHIFT, KP_End,       movetoworkspace, 1
bind = $mod SHIFT, KP_Down,      movetoworkspace, 2
bind = $mod SHIFT, KP_Next,      movetoworkspace, 3
bind = $mod SHIFT, KP_Left,      movetoworkspace, 4
bind = $mod SHIFT, KP_Begin,     movetoworkspace, 5
bind = $mod SHIFT, KP_Right,     movetoworkspace, 6
bind = $mod SHIFT, KP_Home,      movetoworkspace, 7
bind = $mod SHIFT, KP_Up,        movetoworkspace, 8
bind = $mod SHIFT, KP_Prior,     movetoworkspace, 9
bind = $mod SHIFT, KP_Insert,    movetoworkspace, 10

# █▀▄▀█ █ █▀ █▀▀
# █░▀░█ █ ▄█ █▄▄
# Toggle waybar
bind = $mod, N,				exec, pgrep waybar > /dev/null && killall waybar || waybar --config $waybar_config --style $waybar_style &
# Reload hyprland
bind = $mod SHIFT, R,		exec, hyprctl reload
# Change Wallpapers
bind = $mod SHIFT, W, 		exec, ~/.config/hypr/my_conf/random-wallpaper.sh
# Power
bind=$mod SHIFT, End, 		exec, poweroff
bind=$mod SHIFT, Home, 		exec, reboot

# █▀ █▀▀ █▀█ █▀▀ █▀▀ █▄░█ █▀ █░█ █▀█ ▀█▀ █▀
# ▄█ █▄▄ █▀▄ ██▄ ██▄ █░▀█ ▄█ █▀█ █▄█ ░█░ ▄█
	# Fullscreen
bind =$mod, P, 			exec, flameshot full -p ~/pictures
	# Select region (GUI)
bind =$mod SHIFT, P, 		exec, flameshot gui
	# Selection region and copy to clipboard
bind =$mod CTRL, P,	 		exec, flameshot gui -c
